{
  "name": "@deepseek-ai/dsh-tool-web-fetch-plus",
  "description": "Model-facing web_fetch tool with render modes (raw/text/text_compact) over the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.1.0-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/tool-web-fetch-plus"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
